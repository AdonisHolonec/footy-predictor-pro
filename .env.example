SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-public-key
# Obligatoriu in productie (Vercel): fara el, crons din vercel.json primesc 401 la rute protejate (history sync, prewarm, backtest snapshot, etc.).
# Vercel trimite Authorization: Bearer <CRON_SECRET> cand secretul e setat in Project Settings.
CRON_SECRET=your-random-sync-secret
# Trusted app origin for Stripe redirects + admin internal fetches (never use request Host).
# Required in production. Example: https://footy-predictor-pro.vercel.app
PUBLIC_BASE_URL=https://your-app.vercel.app
APP_BASE_URL=https://your-app.vercel.app
# Optional extra hostnames (CSV) allowed for CORS / redirects
# ALLOWED_APP_HOSTS=your-custom-domain.com
# Emergency only (prod): ALLOW_VERCEL_CRON_UA_FALLBACK=1 AND ALLOW_VERCEL_CRON_UA_EMERGENCY=1
# Calibration CV: time (default) | random (legacy)
# CALIB_CV_MODE=time
# MODEL_SELECT_MIN_SAMPLES=100

# Stripe billing (server)
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_PREMIUM=price_...
# STRIPE_PRICE_ULTRA=price_...
# VITE_STRIPE_PUBLISHABLE_KEY=pk_live_...

# Server-only comma-separated admin emails. Promotes profiles.role after login (POST /api/fixtures?syncBootstrapAdmin=1).
# Do NOT use VITE_ADMIN_EMAILS — that would expose the list in the public JS bundle.
ADMIN_EMAILS=admin@your-domain.com
RESEND_API_KEY=your-resend-api-key
NOTIFY_FROM_EMAIL=alerts@your-domain.com
BACKTEST_DAYS=45

# ==============================================================================
# API-Football provider — dual mode (auto-detect)
# ==============================================================================
# OPŢIUNEA 1 (RECOMANDAT): direct de la api-sports.io ($19/lună plan PRO, latency mai mică).
# Setezi doar APISPORTS_KEY; UPSTREAM_BASE_URL devine automat v3.football.api-sports.io.
APISPORTS_KEY=your-apisports-key
# UPSTREAM_BASE_URL=https://v3.football.api-sports.io   # opţional; override doar dacă e nevoie

# OPŢIUNEA 2 (LEGACY): prin RapidAPI (mai scump ~$25/lună, 1 hop extra).
# Dacă APISPORTS_KEY NU e setat, pipeline-ul foloseşte aceste variabile ca fallback.
# X_RAPIDAPI_KEY=your-rapidapi-key
# X_RAPIDAPI_HOST=api-football-v1.p.rapidapi.com
# UPSTREAM_BASE_URL=https://api-football-v1.p.rapidapi.com/v3

# Optional: cache prewarm cron configuration
PREWARM_LEAGUE_IDS=39,140,135,78,61,2,3,848,88,283
PREWARM_SEASON=2025

# Optional: GET/POST /api/cron/warm-predict (Vercel Cron sends Authorization: Bearer CRON_SECRET)
# Ruleaza /api/warm apoi /api/predict pe acelasi deployment (fara JWT user = fara quota zilnica user).
# CRON_WARM_PREDICT_BASE_URL=https://your-app.vercel.app
# CRON_WARM_PREDICT_DATE=2026-04-18
# CRON_WARM_PREDICT_LEAGUE_IDS=39,140,135,78,61,2,3,283
# CRON_HISTORY_SYNC_DAYS=30

# Optional: Vercel KV — limita cereri anonime warm/predict pe IP/ora (sau KV_REST_API_URL / KV_REST_API_TOKEN)
# STORAGEE_KV_REST_API_URL=
# STORAGEE_KV_REST_API_TOKEN=
# ANON_RATE_WARM_PER_HOUR=24
# ANON_RATE_PREDICT_PER_HOUR=16

# Daily warm / predict *action* caps (separate counters; same max per tier)
# FREE_TIER_DAILY_ACTION_LIMIT=5
# PREMIUM_TIER_DAILY_ACTION_LIMIT=20
# ULTRA_TIER_DAILY_ACTION_LIMIT=50

# Daily match-row caps (paid live predict)
# FREE_TIER_DAILY_MATCH_LIMIT=10
# PREMIUM_TIER_DAILY_MATCH_LIMIT=25
# ULTRA_TIER_DAILY_MATCH_LIMIT=50

# API-Football daily budget circuit breaker (C10)
# Soft: predict → DB-only, warm skips teamstats. Hard: block upstream in getWithCache.
# Premium: when admin/cron already predicted all selected fixtures for the date, serve DB (no live recompute).
# Set PREMIUM_PREDICT_DB_CACHE=0 to disable. User can force live with ?forceLive=1.
# PREMIUM_PREDICT_DB_CACHE=1

# API_BUDGET_SOFT_PCT=80
# API_BUDGET_HARD_PCT=95
# API_BUDGET_RESERVE_CALLS=80
# API_BUDGET_CIRCUIT_DISABLED=1
