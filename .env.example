SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-public-key
# Obligatoriu in productie (Vercel): fara el, crons din vercel.json primesc 401 la rute protejate (history sync, prewarm, backtest snapshot, etc.).
# Vercel trimite Authorization: Bearer <CRON_SECRET> cand secretul e setat in Project Settings.
CRON_SECRET=your-random-sync-secret
# Trusted app origin for Stripe redirects + admin internal fetches (never use request Host).
# Required in production. Example: https://footy-predictor-pro.vercel.app
PUBLIC_BASE_URL=https://your-app.vercel.app
APP_BASE_URL=https://your-app.vercel.app
# Optional extra hostnames (CSV) allowed for CORS / redirects
# ALLOWED_APP_HOSTS=your-custom-domain.com
# Emergency only (prod): ALLOW_VERCEL_CRON_UA_FALLBACK=1 AND ALLOW_VERCEL_CRON_UA_EMERGENCY=1
# Calibration CV: time (default) | random (legacy)
# CALIB_CV_MODE=time
# MODEL_SELECT_MIN_SAMPLES=100

# Stripe billing (server)
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_PREMIUM=price_...
# STRIPE_PRICE_ULTRA=price_...
# VITE_STRIPE_PUBLISHABLE_KEY=pk_live_...

# Server-only comma-separated admin emails. Promotes profiles.role after login (POST /api/fixtures?syncBootstrapAdmin=1).
# Do NOT use VITE_ADMIN_EMAILS — that would expose the list in the public JS bundle.
ADMIN_EMAILS=admin@your-domain.com
RESEND_API_KEY=your-resend-api-key
NOTIFY_FROM_EMAIL=alerts@your-domain.com
BACKTEST_DAYS=45

# ==============================================================================
# API-Football provider — dual mode (auto-detect)
# ==============================================================================
# OPŢIUNEA 1 (RECOMANDAT): direct de la api-sports.io ($19/lună plan PRO, latency mai mică).
# Setezi doar APISPORTS_KEY; UPSTREAM_BASE_URL devine automat v3.football.api-sports.io.
APISPORTS_KEY=your-apisports-key
# UPSTREAM_BASE_URL=https://v3.football.api-sports.io   # opţional; override doar dacă e nevoie

# OPŢIUNEA 2 (LEGACY): prin RapidAPI (mai scump ~$25/lună, 1 hop extra).
# Dacă APISPORTS_KEY NU e setat, pipeline-ul foloseşte aceste variabile ca fallback.
# X_RAPIDAPI_KEY=your-rapidapi-key
# X_RAPIDAPI_HOST=api-football-v1.p.rapidapi.com
# UPSTREAM_BASE_URL=https://api-football-v1.p.rapidapi.com/v3

# Optional: cache prewarm cron configuration
PREWARM_LEAGUE_IDS=39,140,135,78,61,2,3,848,88,283
PREWARM_SEASON=2025

# Optional: GET/POST /api/cron/warm-predict (Vercel Cron sends Authorization: Bearer CRON_SECRET)
# Ruleaza /api/warm apoi /api/predict pe acelasi deployment (fara JWT user = fara quota zilnica user).
# CRON_WARM_PREDICT_BASE_URL=https://your-app.vercel.app
# CRON_WARM_PREDICT_DATE=2026-04-18
# CRON_WARM_PREDICT_LEAGUE_IDS=39,140,135,78,61,2,3,283
# CRON_HISTORY_SYNC_DAYS=30

# Optional: Vercel KV — limita cereri anonime warm/predict pe IP/ora (sau KV_REST_API_URL / KV_REST_API_TOKEN)
# STORAGEE_KV_REST_API_URL=
# STORAGEE_KV_REST_API_TOKEN=
# ANON_RATE_WARM_PER_HOUR=24
# ANON_RATE_PREDICT_PER_HOUR=16

# Optional: Vercel AI Gateway — real AI-generated Match Momentum narration (server-utils/momentum/narrateMatchState.js).
# Without this key the feature no-ops silently and the widget keeps using its deterministic sentence — nothing breaks.
# Get a key at https://vercel.com/d?to=%2F%5Bteam%5D%2F%7E%2Fai-gateway%2Fapi-keys&title=AI+Gateway+API+Keys
# AI_GATEWAY_API_KEY=
# MOMENTUM_NARRATIVE_MODEL=anthropic/claude-haiku-4.5

# Daily warm / predict *action* caps (separate counters; same max per tier)
# FREE_TIER_DAILY_ACTION_LIMIT=5
# PREMIUM_TIER_DAILY_ACTION_LIMIT=20
# ULTRA_TIER_DAILY_ACTION_LIMIT=50

# Daily match-row caps (paid live predict)
# FREE_TIER_DAILY_MATCH_LIMIT=10
# PREMIUM_TIER_DAILY_MATCH_LIMIT=25
# ULTRA_TIER_DAILY_MATCH_LIMIT=50

# API-Football daily budget circuit breaker (C10)
# Soft: predict → DB-only, warm skips teamstats. Hard: block upstream in getWithCache.
# Premium: when admin/cron already predicted all selected fixtures for the date, serve DB (no live recompute).
# Set PREMIUM_PREDICT_DB_CACHE=0 to disable. User can force live with ?forceLive=1.
# PREMIUM_PREDICT_DB_CACHE=1

# API_BUDGET_SOFT_PCT=80
# API_BUDGET_HARD_PCT=95
# API_BUDGET_RESERVE_CALLS=80
# API_BUDGET_CIRCUIT_DISABLED=1

# ==============================================================================
# Prediction feature flags — all default OFF, opt-in only, never change default behavior
# ==============================================================================
# Cards market (yellow/red cards Poisson block on probs.cards). Off by default —
# mirrors Corners/Shots, but has no settlement source yet (no cardsTotal actual-
# outcome field), so keep off in production until that exists.
# PREDICT_ENABLE_CARDS=0

# Optional internal debug metadata attached to predictions (motivation activation
# status, competition-keyword match, motivation multiplier applied, clean-sheet
# blend applied yes/no, empirical BTTS value). Off by default. Even when on,
# accessTier.js strips it for every tier — only requests that already bypass
# tier masking entirely (cron / quota-exempt admin accounts, see
# Stage11Masking.js) can ever see it. Never sent to normal (FREE/PREMIUM/ULTRA)
# users regardless of this flag.
# PREDICT_DEBUG_METADATA=0

# API-Football /predictions benchmark (comparison-only vs our own recommendation).
# Off by default — purely additive analytics, fetched out-of-band via cron
# (api/cron/predictionBenchmarkSweep.js) from already-persisted predictions_history
# rows. Never read by PredictorV3/Stage00-08 or the Recommendation Engine.
# PREDICTION_BENCHMARK_ENABLED=0
# PREDICTION_BENCHMARK_CACHE_TTL_SEC=21600
# Window and per-run FETCH budget. The budget caps upstream fetches, not rows scanned:
# candidates are over-fetched by PREDICTION_BENCHMARK_SCAN_MULTIPLIER so that already
# benchmarked fixtures do not consume it. Accrual of comparable, settled pairs is the
# binding constraint on the meta-learning layer, so these are the two knobs that matter.
# Each fetched fixture costs up to 2 upstream calls (/predictions + /fixtures), both
# cached, and all of it routes through apiBudgetCircuit.js.
# PREDICTION_BENCHMARK_SWEEP_WINDOW_DAYS=7
# PREDICTION_BENCHMARK_SWEEP_BUDGET=120
# PREDICTION_BENCHMARK_SCAN_MULTIPLIER=6

# --- Meta Learning & Benchmark Intelligence (read-only analytics layer) -------------
# Derived meta_* tables only (migration 040). Never read by PredictorV3, the pipeline,
# the Recommendation Engine or ValueEngine. Populated by
# /api/cron/daily-ml?mode=meta-learning-refresh; makes NO upstream API calls.
# See docs/META_LEARNING_BENCHMARK_INTELLIGENCE.md for every threshold below.
# META_CONTEXT_VERSION=ctx-v1
# META_ETL_WINDOW_DAYS=365
# META_LEAGUE_TIERS_PATH=
# Statistical gates — these are anti-p-hacking machinery, not tuning knobs. Loosening
# them manufactures confident nonsense out of small samples.
# META_MIN_DISCORDANT_DOMINANT=25
# META_MIN_DISCORDANT_LEANING=12
# META_Q_DOMINANT=0.05
# META_MIN_EFFECT_PP=4
# META_PRICED_COVERAGE_FLOOR_PCT=60

# E2E (Playwright) — dedicated production test account; keep real values in the gitignored .env.e2e.local
E2E_EMAIL=
E2E_PASSWORD=
# E2E_BASE_URL defaults to production; override to point the suite elsewhere
E2E_BASE_URL=

# ==============================================================================
# Referral IP hashing (PR3b) — server-only
# ==============================================================================
# Keys the HMAC-SHA256 that turns a claimant's IP into referral_attributions.ip_hash,
# a SOFT fraud signal a human compares in admin review. It is never a block: NAT,
# offices and phone networks put unrelated people behind one address.
#
# MUST BE ITS OWN SECRET. Do not point this at CRON_SECRET, STRIPE_WEBHOOK_SECRET or
# SUPABASE_SERVICE_ROLE_KEY: those rotate on their own schedules, and a rotation would
# silently void every stored hash while the column still looks populated.
#
# Minimum 16 characters, from a CSPRNG (`openssl rand -hex 32`). Required in
# production — a claim returns 503 without it rather than writing a NULL that reads
# as "no IP available". Outside production the claim proceeds and reports skipped.
# Rotating it discards the historic signal by design; nothing else breaks.
# REFERRAL_IP_HASH_SECRET=
