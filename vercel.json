{
  "functions": {
    "api/cron/warm-predict.js": {
      "maxDuration": 300
    },
    "api/cron/daily-ml.js": {
      "maxDuration": 300
    }
  },
  "rewrites": [
    { "source": "/api/stripe-webhook", "destination": "/api/billing?view=webhook" },
    { "source": "/api/activate-trial", "destination": "/api/billing?view=trial" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; base-uri 'self'; frame-ancestors 'none'; object-src 'none'; img-src 'self' data: https:; font-src 'self' data: https:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' https://js.stripe.com; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://api.stripe.com https://*.api-sports.io https://v3.football.api-sports.io https://geocoding-api.open-meteo.com https://api.open-meteo.com https://archive-api.open-meteo.com; frame-src https://js.stripe.com https://hooks.stripe.com; form-action 'self' https://checkout.stripe.com"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/history?sync=1&closing=1&days=45",
      "schedule": "30 11 * * *"
    },
    {
      "path": "/api/history?sync=1&closing=1&days=45",
      "schedule": "30 14 * * *"
    },
    {
      "path": "/api/history?sync=1&closing=1&days=45",
      "schedule": "30 17 * * *"
    },
    {
      "path": "/api/history?sync=1&closing=1&days=45",
      "schedule": "0 20 * * *"
    },
    {
      "path": "/api/history?sync=1&closing=1&days=45",
      "schedule": "30 22 * * *"
    },
    {
      "path": "/api/backtest?view=snapshot&days=45",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/daily-ml?mode=all",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/warm-predict",
      "schedule": "20 11 * * *"
    },
    {
      "path": "/api/cron/warm-predict",
      "schedule": "20 14 * * *"
    },
    {
      "path": "/api/cron/warm-predict",
      "schedule": "20 17 * * *"
    },
    {
      "path": "/api/cron/daily-ml?mode=ops-report",
      "schedule": "5 0 * * *"
    },
    {
      "path": "/api/cron/daily-ml?mode=model-selection",
      "schedule": "35 3 * * *"
    },
    {
      "path": "/api/cron/daily-ml?mode=prediction-benchmark-sweep",
      "schedule": "45 11 * * *"
    }
  ]
}
