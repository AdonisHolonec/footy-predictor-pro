{
  "functions": {
    "api/cron/warm-predict.js": {
      "maxDuration": 300
    },
    "api/cron/daily-ml.js": {
      "maxDuration": 300
    }
  },
  "rewrites": [
    { "source": "/api/stripe-webhook", "destination": "/api/billing?view=webhook" },
    { "source": "/api/activate-trial", "destination": "/api/billing?view=trial" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/history?sync=1&days=7",
      "schedule": "30 11 * * *"
    },
    {
      "path": "/api/history?sync=1&days=7",
      "schedule": "30 14 * * *"
    },
    {
      "path": "/api/history?sync=1&days=7",
      "schedule": "30 17 * * *"
    },
    {
      "path": "/api/backtest?view=snapshot&days=45",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/daily-ml?mode=all",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/warm-predict",
      "schedule": "20 11 * * *"
    },
    {
      "path": "/api/cron/warm-predict",
      "schedule": "20 14 * * *"
    },
    {
      "path": "/api/cron/warm-predict",
      "schedule": "20 17 * * *"
    },
    {
      "path": "/api/cron/daily-ml?mode=ops-report",
      "schedule": "5 0 * * *"
    },
    {
      "path": "/api/cron/daily-ml?mode=model-selection",
      "schedule": "35 3 * * *"
    }
  ]
}
