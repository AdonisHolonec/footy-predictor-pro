{
  "name": "footy-predictor-ui",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit -p tsconfig.ci.json",
    "lint": "tsc --noEmit -p tsconfig.ci.json",
    "test": "npm run test:math && npm run test:security && npm run test:validation && npm run test:unit && npm run test:golden",
    "test:math": "node --test tests/math.test.js",
    "test:security": "node --test tests/securityP0.test.js tests/apiAuth.fixtures.test.js",
    "test:validation": "node --test tests/walkForward.test.js tests/clv.test.js tests/htGoals.test.js tests/ultraUniqueQuota.test.js",
    "test:unit": "vitest run src",
    "test:golden": "vitest run tests/pipeline/goldenFixture.test.js",
    "test:golden:record": "node scripts/record-golden-fixture.mjs",
    "preview": "vite preview",
    "api": "npm --prefix server run api",
    "backtest": "node --env-file=.env.local scripts/backtest.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.103.3",
    "@upstash/redis": "^1.37.0",
    "@vercel/kv": "^3.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^7.14.1",
    "recharts": "^2.15.4",
    "redis": "^5.11.0",
    "stripe": "^22.3.2"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.1.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vercel/node": "^5.5.28",
    "@vitejs/plugin-react": "^5.0.1",
    "autoprefixer": "^10.4.27",
    "jsdom": "^29.0.2",
    "postcss": "^8.5.9",
    "supabase": "^2.92.1",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.2",
    "vite": "^5.3.4",
    "vitest": "^4.1.5"
  },
  "engines": {
    "node": ">=18"
  }
}
